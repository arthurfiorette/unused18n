{
  "name": "unused18n",
  "version": "0.1.1",
  "description": "Type-aware unused i18next dictionary linter for TypeScript and JSON dictionaries.",
  "keywords": [
    "i18n",
    "i18next",
    "typescript",
    "static-analysis",
    "cli",
    "linter"
  ],
  "homepage": "https://github.com/arthurfiorette/unused18n#readme",
  "bugs": {
    "url": "https://github.com/arthurfiorette/unused18n/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arthurfiorette/unused18n.git"
  },
  "funding": "https://github.com/arthurfiorette/unused18n?sponsor=1",
  "license": "MIT",
  "author": "Arthur Fiorette <me@arthur.place>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "unused18n": "bin/run.js"
  },
  "scripts": {
    "build": "pnpm schema && pnpm clean && tsc -p tsconfig.build.json",
    "check": "pnpm lint-ci && pnpm test-types && pnpm test",
    "clean": "node --input-type=module -e \"import fs from 'node:fs'; fs.rmSync('dist', { recursive: true, force: true })\"",
    "format": "biome format --write .",
    "lint": "biome check .",
    "lint-ci": "biome ci .",
    "lint-fix": "biome check --write --unsafe .",
    "prepack": "pnpm build",
    "schema": "ts-json-schema-generator -p src/types.ts -t Unused18nConfig -f tsconfig.json -o schema.json --id Unused18nConfig --minify",
    "test": "pnpm build && node --test test/*.test.mjs",
    "test-types": "tsc --noEmit"
  },
  "oclif": {
    "bin": "unused18n",
    "commands": {
      "identifier": "COMMANDS",
      "strategy": "explicit",
      "target": "./dist/index.js"
    },
    "dirname": "unused18n",
    "exitCodes": {
      "default": 2,
      "failedFlagParsing": 2,
      "failedFlagValidation": 2,
      "nonExistentFlag": 2,
      "requiredArgs": 2,
      "unexpectedArgs": 2
    },
    "plugins": [
      "@oclif/plugin-autocomplete",
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-warn-if-update-available"
    ]
  },
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-autocomplete": "^3.2.56",
    "@oclif/plugin-help": "^6.2.58",
    "@oclif/plugin-not-found": "^3.2.93",
    "@oclif/plugin-warn-if-update-available": "^3.1.73",
    "@typescript/typescript6": "^6.0.2"
  },
  "devDependencies": {
    "@arthurfiorette/biomejs-config": "^2.0.1",
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.2.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.23.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "onFail": "error",
      "version": ">=24.16"
    }
  }
}
